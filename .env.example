# ============================================================================
# Acadvizen - Required Environment Variables
# ============================================================================
# Copy this file to .env.local or .env.test.local and fill in your values.
# NEVER commit real secrets or test credentials to version control.

# -- Supabase (required) -------------------------------------------------
# Get these from your Supabase project dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# WARNING: SUPABASE_SERVICE_ROLE_KEY bypasses RLS. Keep it secret.
# Only used server-side for admin operations.

# -- Application (required) ----------------------------------------------
NEXT_PUBLIC_APP_URL=https://acadvizen.com
NODE_ENV=development

# -- E2E test credentials (placeholders only) ----------------------------
E2E_BASE_URL=http://127.0.0.1:3200
E2E_ADMIN_EMAIL=test-admin@example.com
E2E_ADMIN_PASSWORD=replace-with-test-admin-password
E2E_ALLOW_DESTRUCTIVE_CMS_TESTS=false
E2E_TEST_PREFIX=e2e-acadvizen
# Only set E2E_ALLOW_DESTRUCTIVE_CMS_TESTS=true for a staging or disposable database.
# Never point destructive CMS tests at production data.

# -- Optional: Analytics --------------------------------------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# -- Optional: SMTP / Email ----------------------------------------------
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# -- Optional: Storage ----------------------------------------------------
# NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1
