# Acadvizen Digital Marketing - Environment Configuration
# Copy this file to .env.local and fill in the values

# Supabase Configuration (Required)
# Get these from your Supabase project dashboard (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Server-side only, keep secret!)
# Found in Supabase Dashboard → Settings → API → service_role key
# WARNING: This key bypasses Row Level Security. Never expose it client-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Next.js Configuration
NEXT_PUBLIC_BASE_PATH=/
NODE_ENV=development

# Analytics (Optional)
# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Tag Manager ID
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=1234567890

# Site URL (Used for canonical URLs and sitemap)
NEXT_PUBLIC_SITE_URL=https://acadvizen.com

